# OpenClaw Observability v2 — environment configuration
#
# Copy this file to `.env` in the same directory and fill in the values.
# `.env` itself is git-ignored; never commit a real token.
#
#   cp .env.example .env
#   vim .env

# Bearer token for HTTP API auth. When set, all /api/* endpoints require
# `Authorization: Bearer <token>` or `?token=<token>`. Localhost and
# /healthz are exempt. Values may be quoted. Leave empty to disable auth entirely (not
# recommended when exposing the dashboard via a tunnel).
OBS_AUTH_TOKEN=

# Public tunnel safety valve. Tunnel scripts refuse to expose the dashboard
# without OBS_AUTH_TOKEN unless this is explicitly set to 1.
OBS_ALLOW_UNAUTH_TUNNEL=0

# Fixed ngrok domain (e.g. my-dashboard.ngrok-free.dev). Only used by
# scripts/tunnel-ngrok.sh. Leave empty if you don't use ngrok.
OBS_NGROK_DOMAIN=

# Optional hint for the fixed public URL (used by dashboard-tunnel skill).
# Usually this is https://$OBS_NGROK_DOMAIN, but you can override if you
# front the tunnel with a custom reverse proxy.
OBS_FIXED_URL=

# Optional managed-workflow adapter allowlist.
#   auto = detect supported local managed workflow blocks
#   none = disable managed workflow artifact parsing
#   openclaw-managed-workflow = only the public generic block format
OBS_WORKFLOW_ADAPTERS=auto
