{
  "name": "openclaw-observability",
  "version": "0.1.4",
  "description": "OpenClaw observability dashboard — transcript-based session monitoring",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/houyili/openclaw-observability.git"
  },
  "bugs": {
    "url": "https://github.com/houyili/openclaw-observability/issues"
  },
  "homepage": "https://github.com/houyili/openclaw-observability#readme",
  "keywords": [
    "openclaw",
    "observability",
    "agent",
    "transcripts",
    "sqlite",
    "dashboard"
  ],
  "files": [
    "src",
    "scripts",
    "tests",
    "docs",
    "README.md",
    "DATA_ACCESS.md",
    "LICENSE",
    ".env.example",
    "*.plist.template"
  ],
  "scripts": {
    "start": "node --experimental-sqlite --experimental-strip-types --no-warnings src/index.ts",
    "dev": "node --experimental-sqlite --experimental-strip-types --watch --no-warnings src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "coverage": "c8 --reporter=text --reporter=lcov --reporter=html --reports-dir=coverage npm run test:hermetic",
    "coverage:check": "c8 check-coverage --lines 80 --functions 85 --branches 70",
    "test": "./tests/run-all.sh",
    "test:hermetic": "TEST_FILTER='unit invariants fixture transcript-consistency-e2e prompt-check open-source-sanitization auth-stale context-length cli-commands frontend-detail workflow-projection workflow-frontend session-id-scope env-config service-self-check installer-scripts watcher-rehome token-backfill parent-child mcp-registry-coverage metrics redact demo-seed' ./tests/run-all.sh",
    "test:unit": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/run-tests.ts",
    "test:invariants": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/parser-invariants.test.ts",
    "test:fixture": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/fixture-ingest.test.ts",
    "test:transcript-consistency-e2e": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/transcript-consistency-e2e.test.ts",
    "test:prompt-check": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/prompt-check.test.ts",
    "test:open-source-sanitization": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/open-source-sanitization.test.ts",
    "test:auth-stale": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/auth-stale.test.ts",
    "test:context-length": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/context-length.test.ts",
    "test:cli-commands": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/cli-commands.test.ts",
    "test:frontend-detail": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/frontend-detail-view.test.ts",
    "test:workflow-projection": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/workflow-projection.test.ts",
    "test:workflow-frontend": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/workflow-frontend.test.ts",
    "test:session-id-scope": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/session-id-scope.test.ts",
    "test:env-config": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/env-config.test.ts",
    "test:service-self-check": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/service-self-check.test.ts",
    "test:installer-scripts": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/installer-scripts.test.ts",
    "test:watcher-rehome": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/watcher-rehome.test.ts",
    "test:token-backfill": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/token-backfill.test.ts",
    "test:parent-child": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/parent-child.test.ts",
    "test:mcp-registry-coverage": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/mcp-registry-coverage.test.ts",
    "test:metrics": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/metrics.test.ts",
    "test:redact": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/redact.test.ts",
    "test:demo-seed": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/demo-seed.test.ts",
    "test:integrity": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/data-integrity.test.ts",
    "test:live-e2e": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/live-e2e.test.ts",
    "test:replay": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/replay-verify.ts",
    "test:cross-check": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/cross-check-official.ts",
    "test:perf": "node --experimental-sqlite --experimental-strip-types --no-warnings tests/perf-bench.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^25.9.1",
    "c8": "^11.0.0",
    "typescript": "^6.0.3"
  }
}
